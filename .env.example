# Copy this file to ".env" and fill it in AFTER you have bought and connected your domain.
# Example: VITE_SITE_URL=https://www.your-domain.com
# While this is empty, the build leaves out the canonical URL, og:image URL and sitemap.xml
# (they need a real address to be valid).
VITE_SITE_URL=
VITE_BASE_PATH=/
